   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import uniform\n",
    "\n",
    "a, b = 0, 10\n",
    "\n",
    "x = np.linspace(a, b, 100)\n",
    "pdf = uniform.pdf(x, loc=a, scale=b-a)\n",
    "\n",
    "plt.plot(x, pdf)\n",
    "plt.xlabel('x')\n",
    "plt.ylabel('PDF')\n",
    "plt.grid()\n",
    "plt.show()"
   ]
  }
 ],
